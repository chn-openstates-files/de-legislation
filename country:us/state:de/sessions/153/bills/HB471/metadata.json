  "abstracts": [
    {
      "note": "synopsis",
      "abstract": "This Act clarifies that the operation of an off-highway vehicle (OHV) on shared private roadways within communities is presumed non-permissive. It also clarifies the time period for impoundment of an OHV."
    }
